# Application
APP_NAME="Investment Agent API"
DEBUG=true
ENVIRONMENT=development

# Security - IMPORTANT: Generate a secure secret key
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# Database - Supabase or Local PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/investment_agent

# Redis Cache (Optional - use Upstash for production)
REDIS_URL=redis://localhost:6379/0

# External APIs (from your existing setup)
ALPHA_VANTAGE_API_KEY=your_key_here
FINNHUB_API_KEY=your_key_here
FRED_API_KEY=your_key_here
NEWS_API_KEY=your_key_here

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_15MIN=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
