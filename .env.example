# API Keys (Get free keys from respective providers)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here
NEWS_API_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_key_here

# Trading Configuration
PAPER_TRADING=true
INITIAL_CAPITAL=100000
MAX_POSITION_SIZE=0.15
MIN_CASH_RESERVE=0.10

# Database
DATABASE_URL=sqlite:///investment_agent/data/portfolio.db

# Notifications (Optional)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=recipient@gmail.com

# Slack/Discord Webhooks (Optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Risk Management
MAX_PORTFOLIO_DRAWDOWN=0.20
STOP_LOSS_PERCENTAGE=0.15
TAKE_PROFIT_PERCENTAGE=1.00

# Scanning Configuration
SCAN_SCHEDULE_DAILY=09:00
SCAN_SCHEDULE_WEEKLY=MON:09:00
MIN_MARKET_CAP=100000000
MAX_MARKET_CAP=10000000000
MIN_VOLUME=100000
MIN_PRICE=1.00
MAX_PRICE=100.00

# Canadian Tax Settings
DEFAULT_ACCOUNT_TYPE=TFSA  # TFSA, RRSP, or TAXABLE
CAPITAL_GAINS_TAX_RATE=0.50  # 50% inclusion rate in Canada
MARGINAL_TAX_RATE=0.45  # Your marginal tax rate
